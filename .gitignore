# Rust build output
/target/

# Released binaries are attached to GitHub Releases, not the repo
/dist/

# Launcher data directory (created next to the exe at runtime)
/.minecraft/

# Local scratch
*.log
# PNGs are build artifacts of the intro video (intro/build.js renders them);
# the intro source slides are committed explicitly below.
*.png
!intro/**/*.png

# Private honeypot deployment: never published to the public repository
/private-site/

# wrangler local cache (deployment metadata, not for the repo)
.wrangler/
